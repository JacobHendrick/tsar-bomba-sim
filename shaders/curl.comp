layout(binding = 0) uniform sampler3D uVel;
layout(rgba32f, binding = 0) uniform writeonly image3D oCurl;
vec3 V(ivec3 c) { return texelFetch(uVel, clampC(c), 0).xyz; }
void main() {
  ivec3 c = gid();
  if (outside(c)) return;
  vec3 dx = V(c + ivec3(1, 0, 0)) - V(c - ivec3(1, 0, 0));
  vec3 dy = V(c + ivec3(0, 1, 0)) - V(c - ivec3(0, 1, 0));
  vec3 dz = V(c + ivec3(0, 0, 1)) - V(c - ivec3(0, 0, 1));
  vec3 w = vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x) / (2.0 * cellSize());
  imageStore(oCurl, c, vec4(w, length(w)));
}
